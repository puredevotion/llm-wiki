# App Environment (local, staging, production)
APP_ENV=local

# Server Configuration
KBASE_HTTP_ADDR=:8080
KBASE_AGENT_TOKEN=default-agent-token

# SQL Persistence (Turso/SQLite)
# Local: file:kbase.db
# Production: libsql://your-db-name.turso.io?token=your-auth-token
KBASE_TURSO_DSN=file:kbase.db

# Graph Persistence (LadybugDB)
# Local: kbase_graph
KBASE_GRAPH_DB_PATH=kbase_graph
